{
  "rewrites": [
    {
      "source": "/meet/:room",
      "destination": "/meet.html"
    },
    {
      "source": "/movies",
      "destination": "/movies.html"
    }
  ],
  "headers": [
    {
      "source": "/meet/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self)"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
